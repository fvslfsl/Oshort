{
  "manifest_version": 3,
  "name": "OPERA Shortcut (OShort)",
  "version": "2.3.0",
  "key": "",
  "description": "Floating action button that replays a preset series of menu clicks in OPERA Cloud.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "OPERA Shortcut (OShort)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["default-presets.txt"],
      "matches": [
        "https://*.oraclecloud.com/*",
        "https://*.oraclehospitality.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.oraclecloud.com/*",
        "https://*.oraclehospitality.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.oraclecloud.com/*",
        "https://*.oraclehospitality.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
